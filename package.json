{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "test:e2e:update": "node --test --test-update-snapshots tests/e2e/*.test.ts",
    "test:visual": "docker build -q -t skill-atlas-visual tests/visual && docker run --rm -v \"$PWD\":/work skill-atlas-visual tests/visual/run.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@argos-ci/cli": "6.10.0",
    "@argos-ci/playwright": "7.7.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
